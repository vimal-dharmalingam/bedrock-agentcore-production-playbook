{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ECRRepositoryLifecycle",
            "Effect": "Allow",
            "Action": [
                "ecr:DescribeRepositories",
                "ecr:ListTagsForResource",
                "ecr:TagResource",
                "ecr:UntagResource",
                "ecr:DeleteRepository"
            ],
            "Resource": "arn:aws:ecr:us-east-1:486517829337:repository/bedrock-agentcore-*"
        }
    ]
}
