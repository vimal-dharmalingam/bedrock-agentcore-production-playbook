# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node / npm / CDK
node_modules/
cdk.out/

# AgentCore local state (contains account-specific values, not secrets, but noisy in diffs)
.bedrock_agentcore/
agent_arn.txt

# Env / secrets
.env
.env.local
*.pem
*.key
.Readme.txt

# Google OAuth (Gmail / Drive tools) -- credentials.json is the OAuth client secret
# downloaded from Google Cloud Console, token.json/token.pickle store the granted
# refresh token after the first consent flow. Both are per-user secrets, never source.
credentials.json
token.json
token.pickle

# Zerodha Kite Connect (tools/zerodha) -- kite_session_cache.json holds a real,
# same-day-valid access_token (see kite_session.py for why it can't be a long-lived
# refresh token). Real secret, never source.
kite_session_cache.json

# Drive KB ingestion -- real people_metadata.json / known_locations.json contain real
# family names/relationships and real home/office coordinates. These are meant to be
# uploaded to Drive (see pipelines/drive_kb_ingest/README.md), never committed here.
# Only the *.example.json templates (placeholder data) are meant to live in the repo.
people_metadata.json
known_locations.json

# tools/drive/one_folder_meta.py's debug-dump output -- a full listing of the real
# Drive folder structure (real file/folder names, e.g. ID document scan filenames,
# personal folder names, full name as folder owner). Exploration artifact only, was
# NOT previously gitignored -- caught during a pre-push review before anything had
# actually been committed, no leak occurred, but this must never be tracked.
drive_file_and_folder_structure.json

# pipelines/personal_records/ -- source spreadsheets/text files and everything
# derived from them (cleaned CSVs, etc.) contain real daily health/food logs, real
# travel dates/routes, and real home addresses across three countries. None of it
# belongs in a public repo. Only the schema/backfill *code* is meant to be committed.
pipelines/personal_records/*.xlsx
pipelines/personal_records/*.csv
pipelines/personal_records/Travel History.txt
pipelines/personal_records/Resident History.txt

# pipelines/bank_statements/ -- real Lloyds current account + credit card statement
# PDFs (full sort code/account number, real transaction history, family transfer
# details) and anything derived from them (review CSVs). Only the parser/schema/CDK
# *code* is meant to be committed. .gitkeep keeps the empty raw/ folder itself tracked.
pipelines/bank_statements/raw/*.pdf
pipelines/bank_statements/*.csv
!pipelines/bank_statements/raw/.gitkeep

# Build artifacts (prefetched wheels / packaged zips -- regenerated by build scripts, not
# source. Different scripts across modules use different dir names for the same purpose --
# 01-agentcore-runtime's use vendor/, 04-lambda's and 05-ec2's use build/ -- both are ignored.)
vendor/
build/
deployment_package/
deployment_package.zip

# Terraform -- state files can embed real resource details (ARNs, role attributes, etc.) and
# are regenerable via `terraform init`/`apply`, never committed as a matter of course. The
# provider binary cache (.terraform/) is large and machine-specific. Lock file IS kept (not
# listed here) since it pins provider versions for reproducibility, which is worth sharing.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Debug artifacts (ad hoc CloudWatch log dumps fetched while diagnosing a build failure --
# regenerable via `aws logs get-log-events`, never meant to be committed)
build_log.txt
build_log.json

# OS
.DS_Store
Thumbs.db

# Leftover empty folder from initial setup
deployment/

# Personal research scratch material (YouTube transcripts, etc.) --
# never meant to be committed, source content isn't ours to republish
_research/

# personal-assistant is a separate, standalone project -- it's going into its own repo,
# not this one. It also contains far more real personal data than anything else here
# (bank transactions, live location, food/health logs, real third-party credentials in
# local .env files) that isn't appropriate for this repo's audience even with per-file
# ignore rules. Excluded wholesale rather than relying on nested .gitignore patterns.
10-agentcore-runtime-deepdive/personal-assistant/

# Personal job-search tracking -- real company names/dates/statuses applied to, and
# current salary baseline used as a negotiation anchor. Private job-hunting activity,
# not something to showcase alongside the technical portfolio.
APPLICATIONS-TRACKER.md
companies-to-target.md

# Stray empty file (accidental `aws ...` shell redirect), not source
06-ecs-fargate/cdk/aws
